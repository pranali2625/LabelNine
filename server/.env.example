PORT=5000
NODE_ENV=development

# MySQL (production / Hostinger — NOT used when you run `npm run dev` locally)
# Local dev uses an embedded in-memory MySQL database (see server/dev-start.js).
# To copy production data locally: see server/.env.production.example + npm run db:pull
# IMPORTANT: use DB_HOST=localhost — NOT 127.0.0.1 (Hostinger MySQL rejects TCP)
DB_HOST=localhost
DB_PORT=3306
DB_SOCKET=/var/lib/mysql/mysql.sock
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=labelnine_db

# JWT
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars
JWT_EXPIRE=7d

# Razorpay — https://dashboard.razorpay.com/app/keys
# Use rzp_test_* keys for development; switch to rzp_live_* in production
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
# Webhook secret from Dashboard → Settings → Webhooks (production only)
# Subscribe to: payment.captured, payment.pending (required for Magic Checkout COD)
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Magic Checkout (Dashboard → Magic Checkout → Checkout Settings / Shipping Setup)
# COD ONLY appears in Magic when this Shipping info URL is PUBLIC and returns cod:true.
# Localhost will NOT work — use your live domain (after deploy) or a tunnel to :5000.
#   Get promotions:     https://YOUR_DOMAIN/api/payments/magic/promotions
#   Apply promotions:   https://YOUR_DOMAIN/api/payments/magic/apply-promotion
#   Shipping info:      https://YOUR_DOMAIN/api/payments/magic/shipping-info
# Also enable webhook event: payment.pending (for COD confirmation)
# Platform: Custom E-Commerce Platform · Shipping service type: API

# Product images — stored on disk, served at /uploads/products/<filename>
# Local dev default: server/uploads/products (drop files there manually)
# Hostinger production (outside public_html — survives redeploys):
# PRODUCT_IMAGES_DIR=/home/u835300783/domains/labelnine.in/product-images

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your@gmail.com
SMTP_PASSWORD=your_app_password
FROM_NAME=Label Nine
FROM_EMAIL=noreply@labelnine.com

# Admin (used for login on both local and production)
ADMIN_EMAIL=admin@labelnine.in
ADMIN_PASSWORD=Admin@123

# Local dev: password assigned to customers synced via npm run db:pull (API mode).
# Falls back to ADMIN_PASSWORD when unset. Not used when users are pulled from production MySQL.
# DEV_SYNC_USER_PASSWORD=Dev@123456

# Order notifications (email always sends when SMTP is configured)
NOTIFY_WHATSAPP=true
NOTIFY_SMS=false

# WhatsApp Business Cloud API (Meta) — recommended, no ₹5000 DLT fee
# Setup: https://developers.facebook.com → Create App → WhatsApp → API Setup
WHATSAPP_PHONE_NUMBER_ID=1179802161887488
WHATSAPP_BUSINESS_ACCOUNT_ID=903585196086302
WHATSAPP_ACCESS_TOKEN=your_permanent_access_token
WHATSAPP_API_VERSION=v25.0
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_TEMPLATE_ORDER_CONFIRMED=order_confirmed
WHATSAPP_TEMPLATE_ORDER_STATUS=order_status
WHATSAPP_TEMPLATE_ORDER_CANCELLED=order_cancelled
# Registration / login OTP — see server/templates/whatsapp-registration-otp.json
# Meta Authentication template: choose "Copy code" in WhatsApp Manager (web app — no Android package needed)
WHATSAPP_TEMPLATE_REGISTRATION_OTP=registration_otp
# authentication (default) = Meta fixed OTP body | utility = custom body with name + OTP
WHATSAPP_OTP_TEMPLATE_STYLE=authentication

# SMS (India — requires ~₹5000/year DLT registration; keep off until volume grows)
# Provider: fast2sms (budget-friendly) or msg91
SMS_PROVIDER=fast2sms

# Fast2SMS — https://www.fast2sms.com (₹50 free credit on signup)
# Dev API → DLT SMS → copy API key, sender ID, and Message IDs from DLT Manager
FAST2SMS_API_KEY=your_fast2sms_api_key
FAST2SMS_SENDER_ID=LBNINE
FAST2SMS_TEMPLATE_ORDER_CONFIRMED=1234567890123456789
FAST2SMS_TEMPLATE_ORDER_STATUS=1234567890123456789
FAST2SMS_TEMPLATE_ORDER_CANCELLED=1234567890123456789
# DLT template example: Dear {#var#}, your Label Nine verification code is {#var#}. Valid 10 min. - Label Nine
FAST2SMS_TEMPLATE_REGISTRATION_OTP=1234567890123456789

# MSG91 (optional alternative) — https://msg91.com
# MSG91_AUTH_KEY=your_msg91_auth_key
# MSG91_TEMPLATE_ORDER_CONFIRMED=your_order_confirmed_template_id
# MSG91_TEMPLATE_ORDER_STATUS=your_order_status_template_id
# MSG91_TEMPLATE_ORDER_CANCELLED=your_order_cancelled_template_id
# MSG91_TEMPLATE_REGISTRATION_OTP=your_registration_otp_template_id

# Frontend URL (for CORS + email links)
# Production: https://labelnine.in
CLIENT_URL=http://localhost:5173
# Optional extra origins, comma-separated (e.g. https://www.labelnine.in)
# CORS_ORIGINS=https://www.labelnine.in

# Shiprocket — https://app.shiprocket.in → Settings → API → Create API User
# Pickup location name must match exactly what is configured in your Shiprocket panel
SHIPROCKET_EMAIL=your_api_user@example.com
SHIPROCKET_PASSWORD=your_api_user_password
# Must match the pickup_location name exactly (Settings → Pickup Addresses), not the city
# e.g. "work" — not "Kolhapur"
SHIPROCKET_PICKUP_LOCATION=work
# Webhook: Settings → API → Webhooks → URL: https://labelnine.in/api/logistics/tracking-webhook
# (avoid "shiprocket" or "sr" in the URL path)
SHIPROCKET_WEBHOOK_TOKEN=your_secure_random_token
# Auto-create Shiprocket order when payment is confirmed (false = admin creates manually)
SHIPROCKET_AUTO_CREATE=false
# Auto-assign AWB after creating order in Shiprocket
SHIPROCKET_AUTO_ASSIGN_AWB=false
# Auto-schedule pickup after AWB assignment
SHIPROCKET_AUTO_SCHEDULE_PICKUP=false
# Package defaults (cm / kg per item)
SHIPROCKET_PACKAGE_LENGTH_CM=30
SHIPROCKET_PACKAGE_BREADTH_CM=25
SHIPROCKET_PACKAGE_HEIGHT_CM=5
SHIPROCKET_WEIGHT_PER_ITEM_KG=0.25
SHIPROCKET_HSN_CODE=6205
