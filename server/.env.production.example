# Production credentials for syncing data to local dev.
# Copy to server/.env.production (gitignored)
#
# Easiest: pull products from live site (no MySQL remote access needed)
PROD_API_URL=https://labelnine.in
PROD_ADMIN_EMAIL=admin@labelnine.in
PROD_ADMIN_PASSWORD=your_admin_password
#
# Optional: full database pull via MySQL (npm run db:pull:mysql)
# Required for npm run dev:live and npm run db:test
# PROD_DB_HOST=srv123.hstgr.io
# PROD_DB_PORT=3306
# PROD_DB_USER=u123456789_labelnine
# PROD_DB_PASSWORD=your_production_db_password
# PROD_DB_NAME=u123456789_labelnine_db
