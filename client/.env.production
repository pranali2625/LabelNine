# Production environment variables for Vite build
# These are embedded into the frontend bundle at build time

# Backend API URL (your Render service URL)
VITE_API_URL=/api

# Leave empty — Razorpay key is passed from the server API response (no client-side env needed)
# If you ever need it directly, add:
# VITE_RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXXXXXXXX
